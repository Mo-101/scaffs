# docker-compose.yaml (root): the containerized Postgres, API, and worker
# services. Set a real password here -- an unset/empty value would leave
# Postgres unauthenticated on whatever interface its port is published on.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mostar
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
