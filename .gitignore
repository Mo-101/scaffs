# Environment Variables
.env
*.env
!.env.example
*.env.local
*.env.*.local
# `*.env` matches ".env" but NOT ".env.clean" or ".env.bak-20260904" -- the
# suffix goes the wrong way. Every backup or variant of .env holds the same
# live API keys, so match them by prefix too, and keep the example tracked.
.env.*
!.env.example

# Node & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb
.pnpm-debug.log*

# Vite / Frontend Build Outputs
dist/
frontend/dist/
*.tsbuildinfo

# Python artifacts & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
env.bak-autoexec-20260830/
env.clean/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored: a bare 'lib/' also matched frontend/src/lib/, which silently
# excluded the frontend API client from every commit.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Logs & Temporary files
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# Live market-data runtime cache (recreated by API sync)
backend/agent/paper_sessions/market_data/
backend/agent/paper_sessions/protection_reconcile/

# Credential dumps — never commit raw secrets
MCP.txt
**/MCP.txt
